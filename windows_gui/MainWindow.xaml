<Window x:Class="ChapulinRemoto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chapulín Remoto" Height="680" Width="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <Color x:Key="BgDark">#10161C</Color>
        <Color x:Key="CardBg">#18222B</Color>
        <Color x:Key="BorderDark">#283847</Color>
        <Color x:Key="GreenPrimary">#7CB342</Color>
        <Color x:Key="GreenLight">#9CCC65</Color>
        <Color x:Key="GreenHover">#8BC34A</Color>
        <Color x:Key="GreenPressed">#689F38</Color>
        <Color x:Key="InputBg">#202C38</Color>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#243240"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#38495A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#314254"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#9CCC65"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C2732"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryGreenButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#7CB342"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#7CB342" BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#8BC34A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#689F38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#202C38"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#9CCC65"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#324456"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#9CCC65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabRadioButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E2A36"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7CB342"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="#10161C" BorderBrush="#253545" BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBarGrid" Grid.Row="0" Margin="16,14,16,10" MouseDown="TitleBar_MouseDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#18232C" BorderBrush="#2F4252" BorderThickness="1" Margin="0,0,10,0">
                        <Image x:Name="AppLogoImage" Margin="4"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Chapulín Remoto" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <Border Background="#1E2C38" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v0.1.1" FontSize="10" Foreground="#9CCC65" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Control Remoto PC y Celular" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ModernButton}" Content="―" Width="36" Height="32" Padding="0" Margin="0,0,6,0" Click="BtnMinimize_Click"/>
                    <Button Style="{StaticResource ModernButton}" Content="✕" Width="36" Height="32" Padding="0" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <Border x:Name="TabStripBorder" Grid.Row="1" Background="#16202A" CornerRadius="10" Margin="16,0,16,12" Padding="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <RadioButton x:Name="TabHostRadio" Grid.Column="0" Content="🖥️ Servidor PC" Style="{StaticResource TabRadioButton}" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabClientRadio" Grid.Column="1" Content="📱 Conectar Celular" Style="{StaticResource TabRadioButton}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabViewerRadio" Grid.Column="2" Content="📺 Pantalla Remota" Style="{StaticResource TabRadioButton}" Checked="Tab_Checked"/>
                </Grid>
            </Border>

            <Grid x:Name="ContentGrid" Grid.Row="2" Margin="16,0,16,16">
                <Border x:Name="PanelHost" Background="#17222C" BorderBrush="#253545" BorderThickness="1" CornerRadius="14" Padding="18" Visibility="Visible">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Transmitir Pantalla de esta PC" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Abre Chapulín Remoto en tu celular e ingresa los siguientes datos para controlar esta PC:" 
                                       FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1" Background="#1E2B37" BorderBrush="#2E3F50" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DIRECCIÓN IP DE ESTA PC" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtLocalIp" Text="192.168.1.112" FontSize="18" FontWeight="Bold" Foreground="#9CCC65" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnCopyIp" Grid.Column="1" Style="{StaticResource ModernButton}" Content="Copiar IP" Click="BtnCopyIp_Click"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#1E2B37" BorderBrush="#2E3F50" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="PUERTO" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="47474" FontSize="18" FontWeight="Bold" Foreground="#9CCC65" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#1E2B37" BorderBrush="#2E3F50" BorderThickness="1" CornerRadius="10" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="PIN DE SEGURIDAD" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtHostPin" Text="------" FontSize="18" FontWeight="Bold" Foreground="#9CCC65" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="BtnCopyPin" Grid.Column="1" Style="{StaticResource ModernButton}" Content="Copiar PIN" Click="BtnCopyPin_Click"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="3" Background="#131C24" BorderBrush="#253545" BorderThickness="1" CornerRadius="10" Padding="14" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="ESTADO DE LA CONEXIÓN" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="HostStatusDot" Width="10" Height="10" Fill="#7CB342" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtHostStatus" Text="Esperando cliente celular en la red Wi-Fi..." FontSize="13" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="4" Text="Nota: Ambos dispositivos deben estar conectados a la misma red Wi-Fi." 
                                   FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border x:Name="PanelClient" Background="#17222C" BorderBrush="#253545" BorderThickness="1" CornerRadius="14" Padding="18" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Controlar Celular Remoto" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Abre Chapulín Remoto en tu celular e ingresa los datos que aparecen en 'DATOS DE MI CELULAR':" 
                                       FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,14">
                            <TextBlock Text="IP del Celular:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                            <TextBox x:Name="InputPhoneIp" Text="192.168.1.113" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Puerto:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <TextBox x:Name="InputPhonePort" Text="47474" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PIN mostrado en celular:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <TextBox x:Name="InputPhonePin" Text="" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="BtnConnectPhone" Grid.Row="3" Style="{StaticResource PrimaryGreenButton}" 
                                Content="⚡ Conectar al Celular" Height="46" Click="BtnConnectPhone_Click"/>

                        <Border x:Name="ClientStatusBanner" Grid.Row="4" Background="#131C24" BorderBrush="#253545" BorderThickness="1" 
                                CornerRadius="10" Padding="14" Margin="0,18,0,0" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="ESTADO" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtClientStatus" Text="Listo para conectar al celular." FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="PanelViewer" Background="#0C1014" BorderBrush="#253545" BorderThickness="1" CornerRadius="14" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#141C24" BorderBrush="#22303C" BorderThickness="0,0,0,1" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#7CB342" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtViewerStatus" Text="Celular Conectado" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource ModernButton}" Content="⛶ Pantalla completa" Padding="10,4" FontSize="12" Margin="0,0,8,0" Click="BtnFullscreen_Click"/>
                                    <Button Style="{StaticResource ModernButton}" Content="Desconectar" Padding="10,4" FontSize="12" Click="BtnDisconnectPhone_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Background="#0A0E12" ClipToBounds="True">
                            <TextBlock x:Name="TxtViewerPlaceholder" 
                                       Text="Esperando transmisión de pantalla del celular...&#x0a;Toca 'Transmitir Pantalla' en tu celular si es necesario." 
                                       FontSize="13" Foreground="#9CCC65" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <Image x:Name="PhoneScreenImage" Stretch="Uniform" 
                                   Focusable="True" FocusManager.FocusedElement="{Binding ElementName=PhoneScreenImage}"
                                   MouseDown="PhoneScreen_MouseDown" 
                                   MouseMove="PhoneScreen_MouseMove" 
                                   MouseUp="PhoneScreen_MouseUp" 
                                   MouseWheel="PhoneScreen_MouseWheel"
                                   KeyDown="PhoneScreen_KeyDown"/>

                            <Border x:Name="HintFullscreen" Visibility="Collapsed" Background="#AA0C1014" CornerRadius="8" Padding="12,6"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0">
                                <TextBlock Text="Pantalla completa — ESC para salir · F11 también" FontSize="12" Foreground="#9CCC65"/>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Background="#141C24" BorderBrush="#22303C" BorderThickness="0,1,0,0" Padding="10">
                            <UniformGrid Rows="1" Columns="4">
                                <Button Style="{StaticResource ModernButton}" Content="◁ Atrás" Margin="4,0" Click="NavBack_Click"/>
                                <Button Style="{StaticResource ModernButton}" Content="○ Inicio" Margin="4,0" Click="NavHome_Click"/>
                                <Button Style="{StaticResource ModernButton}" Content="▢ Tareas" Margin="4,0" Click="NavRecents_Click"/>
                                <Button Style="{StaticResource ModernButton}" Content="⏻ Power" Margin="4,0" Click="NavPower_Click"/>
                            </UniformGrid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
